# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置（可选）
DATABASE_URL=sqlite:./bookings.db

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 支付配置（可选）
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# 阿里云/腾讯云配置（可选）
ALIYUN_ACCESS_KEY=...
ALIYUN_SECRET_KEY=...
